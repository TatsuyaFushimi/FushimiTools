<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd用plist（サンプル）。
  配置先: ~/Library/LaunchAgents/com.busoken.flaredownloader.cookiesync.plist
  登録: launchctl load ~/Library/LaunchAgents/com.busoken.flaredownloader.cookiesync.plist
  解除: launchctl unload ~/Library/LaunchAgents/com.busoken.flaredownloader.cookiesync.plist
  毎日AM11:00に sync_cookie.py を実行する設定。
  詳細はREADME.mdを参照。
-->
