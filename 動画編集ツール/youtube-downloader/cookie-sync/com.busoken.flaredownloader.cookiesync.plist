<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.busoken.flaredownloader.cookiesync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/fushimi/Documents/ClaudeCode/Claude作業室/動画編集ツール/youtube-downloader/cookie-sync/venv/bin/python3</string>
        <string>/Users/fushimi/Documents/ClaudeCode/Claude作業室/動画編集ツール/youtube-downloader/cookie-sync/sync_cookie.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CF_ACCOUNT_ID</key>
        <string>8b19ac744d3ed013c02acc920f658786</string>
        <key>CF_KV_NAMESPACE_ID</key>
        <string>6df3870d73ca4859894e5f5bf8fac8d5</string>
